{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://didactum.org/schemas/lesson-package.v2.json",
  "title": "Didactum LessonPackage v2",
  "description": "A lesson, independent of any player. v2 = v1 + what the Didactum chalkboard plays: a drawn board per beat (board.title, at most 3 short written lines, drawing ops in the 100x70 board space), the reading prose, and per-perspective boards. v1 packages are accepted and mapped forward (schema_version 1.0 -> 2.0). Every string is plain text: no HTML, no URLs. Rules beyond this schema: https://didactum.org/llms.txt",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "slug",
    "metadata",
    "problem"
  ],
  "oneOf": [
    {
      "required": [
        "chapters"
      ]
    },
    {
      "required": [
        "acts"
      ]
    }
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "metadata": {
      "type": "object",
      "required": [
        "subject",
        "topic",
        "concept_slugs",
        "grade_band",
        "language",
        "authors",
        "license",
        "never_verbatim_verified"
      ],
      "additionalProperties": false,
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "topic": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "concept_slugs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "maxItems": 5
        },
        "grade_band": {
          "enum": [
            "k-2",
            "3-5",
            "6-8",
            "9-12",
            "college",
            "adult"
          ]
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "maxItems": 10
        },
        "license": {
          "enum": [
            "CC-BY-4.0",
            "CC-BY-SA-4.0",
            "CC0-1.0"
          ]
        },
        "never_verbatim_verified": {
          "type": "boolean"
        },
        "grade": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "description": "Typical US grade (0 = K, 13+ = college)."
        }
      }
    },
    "problem": {
      "type": "object",
      "required": [
        "statement",
        "givens",
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 3,
          "maxLength": 600
        },
        "givens": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "maxItems": 12
        },
        "unknown": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "assessment": {
          "type": "object",
          "required": [
            "answer"
          ],
          "additionalProperties": false,
          "properties": {
            "answer": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "answer_value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "rationale": {
              "type": "string",
              "maxLength": 600
            }
          }
        }
      }
    },
    "problem_chapter_index": {
      "type": "integer",
      "minimum": 0
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      },
      "maxItems": 12
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      },
      "maxItems": 12
    },
    "perspectives": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "reframed_problem",
          "beats"
        ],
        "additionalProperties": false,
        "properties": {
          "reframed_problem": {
            "type": "string",
            "maxLength": 600
          },
          "beats": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "title": {
                  "type": "string",
                  "maxLength": 64
                },
                "say": {
                  "type": "string",
                  "maxLength": 600
                },
                "label_swaps": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "board": {
                  "$ref": "#/$defs/board"
                }
              }
            }
          }
        }
      },
      "propertyNames": {
        "enum": [
          "sports",
          "fantasy",
          "history",
          "astronomy"
        ]
      }
    }
  },
  "$defs": {
    "chapter": {
      "type": "object",
      "required": [
        "id",
        "title",
        "beats"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "role": {
          "enum": [
            "why",
            "history",
            "uses",
            "seek",
            "how",
            "check"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "skippable": {
          "type": "boolean"
        },
        "duration_hint_s": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1800
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/beat"
          },
          "maxItems": 20
        }
      }
    },
    "beat": {
      "type": "object",
      "required": [
        "id",
        "narration"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "narration": {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 600
            },
            "cues": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "word_index"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "word_index": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "maxItems": 20
            },
            "pause_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5000
            },
            "intent": {
              "type": "string",
              "maxLength": 24
            }
          }
        },
        "visuals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visual"
          },
          "maxItems": 12
        },
        "checkin": {
          "type": "object",
          "required": [
            "prompt",
            "choices"
          ],
          "additionalProperties": false,
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 280
            },
            "choices": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "maxLength": 280
              },
              "maxItems": 5
            },
            "hints": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 280
              },
              "maxItems": 3
            },
            "correct_index": {
              "type": "integer",
              "minimum": 0
            },
            "branches": {
              "type": "object",
              "maxProperties": 6,
              "additionalProperties": {
                "type": "string",
                "maxLength": 280
              },
              "description": "What the teacher says after each choice (key = the choice text)."
            }
          }
        },
        "role": {
          "type": "string",
          "pattern": "^[a-z_]{2,20}$",
          "description": "Fine teaching move of this beat (recite, orient, decompose, solve, synthesize, miss, ...). Optional."
        },
        "prose": {
          "type": "string",
          "maxLength": 1500,
          "description": "Optional reading text for this beat (shown under the board, never written on it). Plain text; blank lines separate paragraphs."
        },
        "board": {
          "$ref": "#/$defs/board"
        }
      }
    },
    "visual": {
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "fraction_bar",
            "number_line",
            "geometry_figure",
            "coordinate_graph",
            "equation_steps",
            "balance_scale",
            "diagram",
            "callout",
            "brace"
          ]
        },
        "id": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "region": {
              "enum": [
                "full",
                "left",
                "right",
                "top",
                "bottom",
                "center"
              ]
            },
            "emphasis": {
              "enum": [
                "low",
                "normal",
                "high"
              ]
            },
            "relative_to": {
              "type": "string"
            }
          }
        },
        "reveal_cue": {
          "type": "string"
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the chalkboard shows for this beat. The board is not the transcript: a heading, at most 3 short lines, and a drawing; sentences are spoken.",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 64
        },
        "lines": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 44
          },
          "description": "Written lines (equations, key terms). $...$ is TeX."
        },
        "draw": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/op"
          },
          "description": "Drawing ops in the board space: x 0..100, y 0..70 (keep content inside x 6..94, y 6..62)."
        }
      }
    },
    "op": {
      "type": "object",
      "required": [
        "op"
      ],
      "description": "One board op (line, polyline, polygon, curve, circle, arc, label, math, digitgrid, numberline, baseten, arrow, highlight, pause, group, erase, strike, brace, callout_arrow). An op may carry `say`: one sentence spoken as it is drawn.",
      "properties": {
        "op": {
          "enum": [
            "line",
            "polyline",
            "polygon",
            "curve",
            "circle",
            "arc",
            "label",
            "math",
            "digitgrid",
            "numberline",
            "baseten",
            "arrow",
            "highlight",
            "pause",
            "group",
            "erase",
            "strike",
            "brace",
            "callout_arrow",
            "chalk_cursor"
          ]
        },
        "say": {
          "type": "string",
          "maxLength": 280
        },
        "text": {
          "type": "string",
          "maxLength": 120
        },
        "tex": {
          "type": "string",
          "maxLength": 200
        }
      }
    }
  }
}
