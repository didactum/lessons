  "problem": {
    "statement": "Lines l and m are parallel and cut by a transversal. Two same-side interior angles measure (2x + 10) degrees and (3x + 20) degrees. What is x?",
    "givens": [
      "l is parallel to m",
      "same-side interior angles: 2x + 10 and 3x + 20"
    ],
    "unknown": "x",
    "assessment": {
      "answer": "x = 30",
      "answer_value": "30",
      "rationale": "Same-side interior angles add to 180: 5x + 30 = 180."
    }
  },
  "chapters": [
    {
      "id": "spot-the-trap",
      "role": "seek",
      "title": "The trap hiding in parallel-line questions",
      "duration_hint_s": 40,
      "beats": [
        {
          "id": "trap-1",
          "narration": {
            "text": "Here's the trap. Parallel lines make students set two angles equal, every time, on autopilot. But only some pairs are equal. The pair stuck between the lines on the same side add up to one eighty instead.",
